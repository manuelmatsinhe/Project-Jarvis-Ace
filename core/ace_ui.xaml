<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ace" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
    
    <Window.Resources>
        <SolidColorBrush x:Key="MatteBlack" Color="#080808"/>
        <SolidColorBrush x:Key="PanelBlack" Color="#121212"/>
        <SolidColorBrush x:Key="OffWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DimWhite" Color="#A0A0A0"/>
        
        <Storyboard x:Key="LevitateAnim" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="AvatarHoverTransform" Storyboard.TargetProperty="Y" From="-3" To="3" Duration="0:0:2.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    
    <Grid Name="RootContainer">
        
        <!-- STATE 4: Full Screen Background -->
        <Border Name="FullScreenBg" Background="{StaticResource MatteBlack}" Visibility="Collapsed"/>
        
        <!-- Main Content -->
        <Grid Name="ContentGrid" Margin="15">
            
            <!-- Ambient Navigation Bar -->
            <Border Name="AmbientNavBar" Background="#1A1A1A" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" Padding="10,5" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button Name="BtnNavSolo" Content="Mini Man" Margin="5,0" Padding="15,8" Background="Transparent" Foreground="{StaticResource OffWhite}" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                    <Button Name="BtnNavIsland" Content="Pill" Margin="5,0" Padding="15,8" Background="Transparent" Foreground="{StaticResource OffWhite}" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                    <Button Name="BtnNavBlock" Content="Block" Margin="5,0" Padding="15,8" Background="Transparent" Foreground="{StaticResource OffWhite}" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                    <Button Name="BtnNavExit" Content="Quit" Margin="5,0" Padding="15,8" Background="Transparent" Foreground="#ff5c5c" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            
            <!-- STATE 4: Ambient Info -->
            <StackPanel Name="AmbientInfo" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="100,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Name="AmbientClock" Text="10:45" Foreground="{StaticResource OffWhite}" FontSize="130" FontWeight="Light" Margin="0,0,5,0"/>
                    <TextBlock Name="AmbientAmPm" Text="AM" Foreground="{StaticResource DimWhite}" FontSize="40" FontWeight="Regular" Margin="0,0,0,25" VerticalAlignment="Bottom"/>
                </StackPanel>
                <TextBlock Name="AmbientDate" Text="Saturday, Oct 10" Foreground="{StaticResource OffWhite}" FontSize="32" Margin="5,-10,0,5"/>
                <TextBlock Name="AmbientWeather" Text="Partly Cloudy • 72°F" Foreground="{StaticResource DimWhite}" FontSize="20" Margin="5,0,0,40"/>
                
                <Grid Margin="5,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Agenda Card -->
                    <Border Background="{StaticResource PanelBlack}" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Daily Agenda" Foreground="{StaticResource OffWhite}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="• Saturday, Oct 10" Foreground="{StaticResource DimWhite}" FontSize="14"/>
                                <TextBlock Text="Daily Agenda - 9P" Foreground="#666" FontSize="12" Margin="10,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="• Saturday, 1:50 AM" Foreground="{StaticResource DimWhite}" FontSize="14"/>
                                <TextBlock Text="Partly Cloudy - 72°F" Foreground="#666" FontSize="12" Margin="10,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="• Every Day" Foreground="{StaticResource DimWhite}" FontSize="14"/>
                                <TextBlock Text="Roblox (Codes - All)" Foreground="#666" FontSize="12" Margin="10,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Media Card -->
                    <Border Grid.Column="1" Background="{StaticResource PanelBlack}" CornerRadius="12" Padding="20" Margin="20,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Recent Media" Foreground="{StaticResource OffWhite}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#000" Width="60" Height="60" CornerRadius="8">
                                    <!-- Placeholder album art -->
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <TextBlock Text="Tom On Time" Foreground="{StaticResource OffWhite}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Spotify" Foreground="#1DB954" FontSize="13" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <!-- Fake Media Controls -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <TextBlock Text="⏮" Foreground="{StaticResource OffWhite}" FontSize="20" Margin="10,0"/>
                                <TextBlock Text="⏸" Foreground="{StaticResource OffWhite}" FontSize="20" Margin="10,0"/>
                                <TextBlock Text="⏭" Foreground="{StaticResource OffWhite}" FontSize="20" Margin="10,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Tray and Avatar Container -->
            <Grid Name="MainUIBox" HorizontalAlignment="Right" VerticalAlignment="Top">
                
                <!-- TRAY BORDER (Used for State 2 and State 3) -->
                <Border Name="TrayBorder" Background="{StaticResource MatteBlack}" CornerRadius="30" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Visible">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.7" Direction="270" Color="Black"/>
                    </Border.Effect>
                    
                    <StackPanel Name="TrayStack" Margin="0">
                        
                        <!-- STATE 2: Dynamic Island Pill -->
                        <Grid Name="IslandHeader" Height="70" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/> <!-- Avatar Placeholder Space -->
                                <ColumnDefinition Width="Auto"/> <!-- ACE -->
                                <ColumnDefinition Width="100"/> <!-- Waveform -->
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="1" Text="ACE" Foreground="{StaticResource OffWhite}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,20,0"/>
                            
                            <!-- Small Continuous Waveform for Pill -->
                            <Grid Grid.Column="2" Height="30" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Name="PW1" Width="3" Height="2" Fill="{StaticResource OffWhite}" RadiusX="1" RadiusY="1" Margin="2,0"/>
                                    <Rectangle Name="PW2" Width="3" Height="6" Fill="{StaticResource OffWhite}" RadiusX="1" RadiusY="1" Margin="2,0"/>
                                    <Rectangle Name="PW3" Width="3" Height="12" Fill="{StaticResource OffWhite}" RadiusX="1" RadiusY="1" Margin="2,0"/>
                                    <Rectangle Name="PW4" Width="3" Height="18" Fill="{StaticResource OffWhite}" RadiusX="1" RadiusY="1" Margin="2,0"/>
                                    <Rectangle Name="PW5" Width="3" Height="12" Fill="{StaticResource OffWhite}" RadiusX="1" RadiusY="1" Margin="2,0"/>
                                    <Rectangle Name="PW6" Width="3" Height="6" Fill="{StaticResource OffWhite}" RadiusX="1" RadiusY="1" Margin="2,0"/>
                                    <Rectangle Name="PW7" Width="3" Height="2" Fill="{StaticResource OffWhite}" RadiusX="1" RadiusY="1" Margin="2,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        
                        <!-- STATE 3: Block Mode Body -->
                        <StackPanel Name="BlockBody" Visibility="Collapsed" Margin="25,20,25,20" Width="300">
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/> <!-- Avatar Space -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/> <!-- Right Space -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="ACE" Foreground="{StaticResource OffWhite}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Crisp Waveform (Strips) -->
                            <Grid Height="40" Margin="0,15,0,25">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Name="BW1" Width="5" Height="4" Fill="{StaticResource OffWhite}" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle Name="BW2" Width="5" Height="10" Fill="{StaticResource OffWhite}" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle Name="BW3" Width="5" Height="18" Fill="{StaticResource OffWhite}" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle Name="BW4" Width="5" Height="28" Fill="{StaticResource OffWhite}" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle Name="BW5" Width="5" Height="36" Fill="{StaticResource OffWhite}" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle Name="BW6" Width="5" Height="28" Fill="{StaticResource OffWhite}" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle Name="BW7" Width="5" Height="18" Fill="{StaticResource OffWhite}" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle Name="BW8" Width="5" Height="10" Fill="{StaticResource OffWhite}" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle Name="BW9" Width="5" Height="4" Fill="{StaticResource OffWhite}" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- 3x3 Button Grid -->
                            <UniformGrid Columns="3" Rows="3" Margin="0,0,0,15">
                                <UniformGrid.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#181818"/>
                                        <Setter Property="Foreground" Value="{StaticResource DimWhite}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#2a2a2a"/>
                                        <Setter Property="Margin" Value="4"/>
                                        <Setter Property="Height" Value="60"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <!-- Icon placeholder via TextBlock -->
                                                            <TextBlock Text="◇" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                            <ContentPresenter HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource OffWhite}"/>
                                                <Setter Property="BorderBrush" Value="#555"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </UniformGrid.Resources>
                                <Button Name="BtnScreenshot" Content="Screenshot"/>
                                <Button Name="BtnBrowser" Content="Browser"/>
                                <Button Name="BtnMic" Content="Voice/Mic"/>
                                <Button Name="BtnMode" Content="Ambient"/>
                                <Button Name="BtnPrompts" Content="Prompts"/>
                                <Button Name="BtnSettings" Content="Settings"/>
                                <Button Name="BtnToggleColor" Content="Dark Avatar"/>
                                <Button Name="BtnAutomations" Content="Automations"/>
                                <Button Name="BtnSleep" Content="ACE Sleep" Foreground="#ff5c5c"/>
                            </UniformGrid>
                            
                            <!-- Input Bar -->
                            <Border Background="#151515" CornerRadius="12" BorderBrush="#2a2a2a" BorderThickness="1" Margin="0,5,0,0" Height="44">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="CmdInput" Background="Transparent" Foreground="{StaticResource OffWhite}" BorderThickness="0" 
                                             Padding="12,12" FontSize="12" CaretBrush="{StaticResource OffWhite}" VerticalContentAlignment="Center"/>
                                    <Button Name="BtnRunCmd" Grid.Column="1" Content="➤" Background="Transparent" BorderThickness="0" Foreground="#555" FontSize="16" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Name="IslandStatusText" Text="" Foreground="#777" FontSize="10" Margin="5,8,5,0" TextWrapping="Wrap" MaxHeight="40" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
    
                <!-- AVATAR VIEWBOX -->
                <Viewbox Name="AvatarViewbox" Width="80" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand">
                    <Canvas Name="AvatarCanvas" Width="80" Height="100" Background="Transparent">
                        <Canvas.Effect>
                            <DropShadowEffect x:Name="AvatarGlow" BlurRadius="30" ShadowDepth="0" Color="#FFFFFF" Opacity="0.8"/>
                        </Canvas.Effect>
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="AvatarHoverTransform" Y="0"/>
                        </Canvas.RenderTransform>
                        
                        <!-- Sparkles -->
                        <Ellipse Width="3" Height="3" Fill="{StaticResource OffWhite}" Canvas.Left="15" Canvas.Top="10"/>
                        <Ellipse Width="2" Height="2" Fill="{StaticResource OffWhite}" Canvas.Left="65" Canvas.Top="20"/>
                        <Ellipse Width="4" Height="4" Fill="{StaticResource OffWhite}" Canvas.Left="5" Canvas.Top="50"/>
                        <Ellipse Width="3" Height="3" Fill="{StaticResource OffWhite}" Canvas.Left="75" Canvas.Top="70"/>
                        <Ellipse Width="2" Height="2" Fill="{StaticResource OffWhite}" Canvas.Left="20" Canvas.Top="85"/>
                        <Ellipse Width="3" Height="3" Fill="{StaticResource OffWhite}" Canvas.Left="55" Canvas.Top="90"/>
                        
                        <!-- Legs -->
                        <Rectangle Name="AvatarLeftLeg" Canvas.Left="26" Canvas.Top="82" Width="10" Height="18" RadiusX="5" RadiusY="5" Fill="{StaticResource OffWhite}" />
                        <Rectangle Name="AvatarRightLeg" Canvas.Left="44" Canvas.Top="82" Width="10" Height="18" RadiusX="5" RadiusY="5" Fill="{StaticResource OffWhite}" />
                        
                        <!-- Body (Rectangular with rounded corners) -->
                        <Rectangle Name="AvatarBody" Canvas.Left="17" Canvas.Top="48" Width="46" Height="34" RadiusX="8" RadiusY="8" Fill="{StaticResource OffWhite}" />
                        
                        <!-- Arms (Detached, perfectly leveled) -->
                        <Rectangle Name="LeftArm" Canvas.Left="4" Canvas.Top="48" Width="10" Height="30" RadiusX="5" RadiusY="5" Fill="{StaticResource OffWhite}" />
                        <Rectangle Name="RightArm" Canvas.Left="66" Canvas.Top="48" Width="10" Height="30" RadiusX="5" RadiusY="5" Fill="{StaticResource OffWhite}" />
                        
                        <!-- Head (Round Ellipse) -->
                        <Ellipse Name="AvatarHead" Canvas.Left="15" Canvas.Top="5" Width="50" Height="40" Fill="{StaticResource OffWhite}" />
                        
                        <!-- Eyes (Circular) -->
                        <Ellipse Name="LeftEye" Canvas.Left="27" Canvas.Top="20" Width="6" Height="6" Fill="#111111" />
                        <Ellipse Name="RightEye" Canvas.Left="47" Canvas.Top="20" Width="6" Height="6" Fill="#111111" />
                        
                        <!-- Tie -->
                        <Polygon Name="AvatarTie" Points="38,49 42,49 40,53 43,70 40,78 37,70 40,53" Fill="#111111"/>
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Giant Waveform & Text for Ambient Mode -->
            <StackPanel Name="AmbientWaveformPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,500,210,0">
                <Grid Height="60" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Name="AW1" Width="10" Height="6" Fill="{StaticResource OffWhite}" RadiusX="4" RadiusY="4" Margin="6,0"/>
                        <Rectangle Name="AW2" Width="10" Height="14" Fill="{StaticResource OffWhite}" RadiusX="4" RadiusY="4" Margin="6,0"/>
                        <Rectangle Name="AW3" Width="10" Height="26" Fill="{StaticResource OffWhite}" RadiusX="4" RadiusY="4" Margin="6,0"/>
                        <Rectangle Name="AW4" Width="10" Height="42" Fill="{StaticResource OffWhite}" RadiusX="4" RadiusY="4" Margin="6,0"/>
                        <Rectangle Name="AW5" Width="10" Height="56" Fill="{StaticResource OffWhite}" RadiusX="4" RadiusY="4" Margin="6,0"/>
                        <Rectangle Name="AW6" Width="10" Height="42" Fill="{StaticResource OffWhite}" RadiusX="4" RadiusY="4" Margin="6,0"/>
                        <Rectangle Name="AW7" Width="10" Height="26" Fill="{StaticResource OffWhite}" RadiusX="4" RadiusY="4" Margin="6,0"/>
                        <Rectangle Name="AW8" Width="10" Height="14" Fill="{StaticResource OffWhite}" RadiusX="4" RadiusY="4" Margin="6,0"/>
                        <Rectangle Name="AW9" Width="10" Height="6" Fill="{StaticResource OffWhite}" RadiusX="4" RadiusY="4" Margin="6,0"/>
                    </StackPanel>
                </Grid>
                <TextBlock Name="AmbientStatus" Text="I'm listening, user..." Foreground="{StaticResource DimWhite}" FontSize="24" HorizontalAlignment="Center"/>
                <TextBox Name="AmbientInput" Background="Transparent" Foreground="Transparent" BorderThickness="0" Height="0" Width="0"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
